# Скопируйте в .env и заполните. Файл .env НЕ коммитить.
APP_ENV=production
PUBLIC_URL=https://cinemate.example.com
DOMAIN=cinemate.example.com

# Генерация: openssl rand -hex 32
SECRET_KEY=
INTERNAL_API_TOKEN=
POSTGRES_PASSWORD=
TELEGRAM_WEBHOOK_SECRET=

COOKIE_SECURE=true
ADMIN_EMAIL=you@example.com

# Серверный секрет администратора (BotFather). Пользователи его не вводят.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Ключ API Кинопоиска (только здесь, в репозиторий не попадает)
KINOPOISK_API_KEY=
KINOPOISK_MAX_RPS=5
